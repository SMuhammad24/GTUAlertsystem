# ========================================================
# GTU Circular Automation - Environment Configuration
# ========================================================

# 1. Telegram Bot Token from @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram Chat ID / Group ID / Channel ID (e.g., -1001234567890 or 987654321)
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. Optional: Discord Webhook URL for Multi-Platform Alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# 4. Optional: Google Gemini API Key for AI Summaries (Fallback to smart heuristics if empty)
# GEMINI_API_KEY=your_gemini_api_key_here

# 5. Web Dashboard Port & Host (Default: 8080 on localhost)
WEB_PORT=8080
WEB_HOST=127.0.0.1

# 6. Check Interval in Minutes for daemon mode (Default: 15)
CHECK_INTERVAL_MINUTES=15

# 7. Optional Keyword Filter (Leave empty to receive ALL circulars)
# KEYWORD_FILTER=fee,exam,penalty

# 8. GTU Circular URL (Default: https://www.gtu.ac.in/Circular.aspx)
GTU_CIRCULAR_URL=https://www.gtu.ac.in/Circular.aspx
