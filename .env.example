# ========================================================
# GTU Circular Automation - Environment Configuration
# ========================================================

# 1. Telegram Bot Token from @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram Chat ID / Group ID / Channel ID (e.g., -1001234567890 or 987654321)
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. Check Interval in Minutes for daemon mode (Default: 30)
CHECK_INTERVAL_MINUTES=30

# 4. Optional Keyword Filter (Leave empty to receive ALL circulars)
# Example: fee,exam,result,remedial
# KEYWORD_FILTER=fee,exam,penalty

# 5. GTU Circular URL (Default: https://www.gtu.ac.in/Circular.aspx)
GTU_CIRCULAR_URL=https://www.gtu.ac.in/Circular.aspx
